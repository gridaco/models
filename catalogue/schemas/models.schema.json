{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grida.co/schemas/ai-model-facts-v1.json",
  "title": "Canonical model facts, authoring envelope version 1",
  "description": "Structural interchange schema with sourced, additive model and serving-provider facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text.catalog",
    "image.models",
    "video.models",
    "audio.music.models",
    "audio.sound_effects.models",
    "audio.text_to_speech.models",
    "three_d.models",
    "three_d.model_generation.models",
    "three_d.rigging.models",
    "three_d.rig_check.operation",
    "image_tools.models",
    "embedding.models"
  ],
  "properties": {
    "$schema": {
      "description": "This file's schema: the `$id` of models.schema.json. Generated files always carry it.",
      "const": "https://grida.co/schemas/ai-model-facts-v1.json"
    },
    "text.catalog": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/text_card"
      }
    },
    "image.models": {
      "$ref": "#/$defs/table"
    },
    "video.models": {
      "$ref": "#/$defs/table"
    },
    "audio.music.models": {
      "$ref": "#/$defs/table"
    },
    "audio.sound_effects.models": {
      "$ref": "#/$defs/table"
    },
    "audio.text_to_speech.models": {
      "$ref": "#/$defs/table"
    },
    "three_d.models": {
      "$ref": "#/$defs/table"
    },
    "three_d.model_generation.models": {
      "$ref": "#/$defs/table"
    },
    "three_d.rigging.models": {
      "$ref": "#/$defs/table"
    },
    "image_tools.models": {
      "$ref": "#/$defs/table"
    },
    "embedding.models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "label"]
      }
    },
    "three_d.rig_check.operation": {
      "type": "object",
      "required": ["feature", "provider", "binding_id", "rig_types", "input", "pricing"],
      "properties": {
        "feature": {
          "const": "rig-check"
        },
        "provider": {
          "const": "tripo"
        },
        "binding_id": {
          "const": "rig-check"
        },
        "rig_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "type": "string",
          "minLength": 1,
          "description": "Lab ID resolving in labs.json; independent of the serving provider."
        },
        "release": {
          "type": "object",
          "required": ["date", "basis", "source_url"],
          "additionalProperties": false,
          "properties": {
            "date": {
              "type": ["string", "null"],
              "format": "date"
            },
            "basis": {
              "enum": ["model", "provider_endpoint"]
            },
            "source_url": {
              "type": "string",
              "pattern": "^https://"
            }
          },
          "if": {
            "properties": {
              "date": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "basis": {
                "const": "provider_endpoint"
              }
            }
          }
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "token_pricing": {
          "$ref": "#/$defs/token_pricing"
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provider_endpoint"
          }
        }
      }
    }
  },
  "$defs": {
    "table": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/card"
      }
    },
    "card": {
      "type": "object",
      "required": ["id", "label", "release"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "object",
          "required": ["date", "basis", "source_url"],
          "additionalProperties": false,
          "properties": {
            "date": {
              "type": ["string", "null"],
              "format": "date"
            },
            "basis": {
              "enum": ["model", "provider_endpoint"]
            },
            "source_url": {
              "type": "string",
              "pattern": "^https://"
            }
          },
          "if": {
            "properties": {
              "date": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "basis": {
                "const": "provider_endpoint"
              }
            }
          }
        },
        "providers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["provider", "id"],
            "properties": {
              "provider": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "endpoints": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/provider_endpoint"
                }
              },
              "capabilities": {
                "$ref": "#/$defs/capabilities"
              },
              "token_pricing": {
                "$ref": "#/$defs/token_pricing"
              },
              "limits": {
                "$ref": "#/$defs/limits"
              }
            }
          }
        },
        "vendor": {
          "type": "string",
          "minLength": 1,
          "description": "Lab ID resolving in labs.json; independent of the serving provider."
        },
        "output_token_calculator": {
          "$ref": "#/$defs/output_token_calculator"
        },
        "vision_tokenization": {
          "$ref": "#/$defs/vision_tokenization"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "token_pricing": {
          "$ref": "#/$defs/token_pricing"
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provider_endpoint"
          }
        }
      }
    },
    "text_card": {
      "allOf": [
        {
          "$ref": "#/$defs/card"
        }
      ],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "properties": {
        "image_input_mimes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context_window": {
          "type": "integer",
          "minimum": 1
        },
        "output_limit": {
          "type": "integer",
          "minimum": 1
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input": {
              "type": "number",
              "minimum": 0
            },
            "output": {
              "type": "number",
              "minimum": 0
            },
            "cache_read": {
              "type": "number",
              "minimum": 0
            },
            "cache_write": {
              "type": "number",
              "minimum": 0
            },
            "long_context": {
              "type": "object",
              "additionalProperties": false,
              "required": ["input_tokens_above", "input_multiplier", "output_multiplier"],
              "properties": {
                "input_tokens_above": {
                  "type": "integer",
                  "minimum": 0
                },
                "input_multiplier": {
                  "type": "number",
                  "minimum": 0
                },
                "output_multiplier": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "provider_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "input", "source_url"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "enum": ["text", "image", "video", "audio", "task"]
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/]+(?:/|$)"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "token_pricing": {
          "$ref": "#/$defs/token_pricing"
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "image_constraints": {
          "$ref": "#/$defs/image_constraints"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url"],
      "minProperties": 2,
      "properties": {
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/]+(?:/|$)"
        },
        "image_input": {
          "type": "boolean"
        },
        "tools": {
          "type": "boolean"
        },
        "reasoning": {
          "type": "boolean"
        },
        "structured_output": {
          "type": "boolean"
        },
        "streaming": {
          "type": "boolean"
        }
      }
    },
    "output_token_calculator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "area_offset",
        "area_divisor",
        "short_axis_rounding",
        "token_rounding",
        "quality_axes"
      ],
      "properties": {
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/]+(?:/|$)"
        },
        "area_offset": {
          "type": "integer",
          "minimum": 0
        },
        "area_divisor": {
          "type": "integer",
          "minimum": 1
        },
        "short_axis_rounding": {
          "enum": ["nearest_ties_even"]
        },
        "token_rounding": {
          "enum": ["ceil"]
        },
        "quality_axes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/output_token_example"
          }
        },
        "source_js_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/]+(?:/|$)"
        }
      }
    },
    "output_token_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "quality", "source_url"],
      "anyOf": [
        {
          "required": ["output_tokens"]
        },
        {
          "required": ["usd"]
        }
      ],
      "dependentRequired": {
        "usd_precision": ["usd"]
      },
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "quality": {
          "type": "string",
          "minLength": 1
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "usd": {
          "type": "number",
          "minimum": 0
        },
        "usd_precision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/]+(?:/|$)"
        }
      }
    },
    "vision_tokenization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url"],
      "minProperties": 2,
      "properties": {
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/]+(?:/|$)"
        },
        "patch_size_px": {
          "type": "integer",
          "minimum": 1
        },
        "token_multiplier": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "detail_patch_budgets": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "detail_token_budgets": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "maximum_patch_count": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_tokens_per_image": {
          "type": "integer",
          "minimum": 1
        },
        "tokens_per_image": {
          "type": "integer",
          "minimum": 1
        },
        "detail_maximum_edges": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "token_rounding": {
          "enum": ["ceil"]
        },
        "token_counts_approximate": {
          "type": "boolean"
        }
      }
    },
    "token_pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "unit"],
      "anyOf": [
        {
          "required": ["input"]
        },
        {
          "required": ["output"]
        },
        {
          "required": ["input_cache_read"]
        },
        {
          "required": ["input_cache_write"]
        },
        {
          "required": ["tiers"]
        }
      ],
      "properties": {
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/]+(?:/|$)"
        },
        "unit": {
          "const": "usd_per_token"
        },
        "input": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "description": "Exact non-negative decimal amount; no exponent notation."
        },
        "output": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "description": "Exact non-negative decimal amount; no exponent notation."
        },
        "input_cache_read": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "description": "Exact non-negative decimal amount; no exponent notation."
        },
        "input_cache_write": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "description": "Exact non-negative decimal amount; no exponent notation."
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/token_price_tier"
          }
        }
      }
    },
    "token_price_tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meter", "minimum_input_tokens", "usd_per_token"],
      "properties": {
        "meter": {
          "enum": ["input", "output", "input_cache_read", "input_cache_write"]
        },
        "minimum_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Inclusive lower input-token bound."
        },
        "maximum_input_tokens": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Exclusive upper input-token bound; null or omission means no published upper bound."
        },
        "usd_per_token": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "description": "Exact non-negative decimal amount; no exponent notation."
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "type": {
          "enum": ["string", "number", "integer", "boolean", "array", "object", "null"]
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "multiple_of": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_items": {
          "type": "integer",
          "minimum": 0
        },
        "max_items": {
          "type": "integer",
          "minimum": 0
        },
        "min_length": {
          "type": "integer",
          "minimum": 0
        },
        "max_length": {
          "type": "integer",
          "minimum": 0
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/]+(?:/|$)"
        }
      }
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(?:\\.[a-zA-Z][a-zA-Z0-9_]*)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "image_constraints": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "min_edge": {
          "type": "integer",
          "minimum": 1
        },
        "max_edge": {
          "type": "integer",
          "minimum": 1
        },
        "min_pixels": {
          "type": "integer",
          "minimum": 1
        },
        "max_pixels": {
          "type": "integer",
          "minimum": 1
        },
        "aspect_ratio": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "min": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url"],
      "minProperties": 2,
      "properties": {
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/]+(?:/|$)"
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
